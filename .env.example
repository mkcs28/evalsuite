# Public site URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Project links. Leave empty until the real resources exist; the UI shows
# "link pending" / "coming with v0.1.0" states instead of inventing URLs.
NEXT_PUBLIC_REPOSITORY_URL=
NEXT_PUBLIC_PYPI_URL=

# Playground backend: "mock" (default, in-browser demo) or "api" (future FastAPI).
NEXT_PUBLIC_EVALUATION_BACKEND=mock
# Base URL of the future EvalSuite FastAPI service, e.g. https://api.example.org
# Never put secrets in NEXT_PUBLIC_* variables; they are shipped to the browser.
NEXT_PUBLIC_API_BASE_URL=

# Server-only (never NEXT_PUBLIC_): verifies signed download links issued by the API.
# Must equal EVALSUITE_DOWNLOAD_TOKEN_SECRET on the API.
DOWNLOAD_TOKEN_SECRET=
