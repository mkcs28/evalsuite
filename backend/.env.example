# Copy to backend/.env for local development. Never commit real values.
EVALSUITE_ENV=development
EVALSUITE_DATABASE_URL=postgresql://evalsuite:evalsuite@localhost:5432/evalsuite
# Optional: shared rate limiting across processes/instances.
EVALSUITE_REDIS_URL=redis://localhost:6379/0
# Create tables automatically (dev only). Production runs `alembic upgrade head`.
EVALSUITE_AUTO_CREATE_TABLES=false

# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# All three must be different from each other.
EVALSUITE_JWT_SECRET=
EVALSUITE_API_KEY_PEPPER=
# Signs download links; the website needs the same value in DOWNLOAD_TOKEN_SECRET.
EVALSUITE_DOWNLOAD_TOKEN_SECRET=

EVALSUITE_SITE_URL=http://localhost:3000
EVALSUITE_CORS_ORIGINS=["http://localhost:3000"]

# console (prints reset links to the log; development only) or smtp.
EVALSUITE_EMAIL_BACKEND=console
EVALSUITE_EMAIL_FROM=EvalSuite <no-reply@example.org>
EVALSUITE_SMTP_HOST=
EVALSUITE_SMTP_PORT=587
EVALSUITE_SMTP_USERNAME=
EVALSUITE_SMTP_PASSWORD=
EVALSUITE_SMTP_STARTTLS=true

EVALSUITE_ACCESS_TOKEN_MINUTES=60
EVALSUITE_PASSWORD_RESET_MINUTES=30
EVALSUITE_EVALUATE_REQUESTS_PER_MINUTE=60
EVALSUITE_AUTH_ATTEMPTS_PER_MINUTE=10
EVALSUITE_LOG_LEVEL=INFO
